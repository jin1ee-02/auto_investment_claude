# Hedge Insight (Claude edition) — 비밀 값. 절대 커밋하지 마세요.

# ── SEC EDGAR (공식 소스). "이름 이메일" 형식의 실제 연락처.
SEC_USER_AGENT=Your Name you@example.com
# auto: EDGAR 우선, 차단(403/429) 시 13f.info 로 자동 전환 | edgar | 13finfo
FILINGS_SOURCE=auto
# 선택: OpenFIGI 키가 있으면 EDGAR 경로의 CUSIP→티커 변환이 빨라집니다.
OPENFIGI_API_KEY=

# ── TradingAgents 리서치
# anthropic / openai / google / deepseek / openrouter 등 TradingAgents 가 지원하는 제공자
RESEARCH_PROVIDER=anthropic
RESEARCH_DEEP_MODEL=claude-opus-5-5
RESEARCH_QUICK_MODEL=claude-haiku-4-5-20251001
RESEARCH_DEBATE_ROUNDS=1
RESEARCH_RISK_ROUNDS=1
RESEARCH_LANGUAGE=Korean
RESEARCH_MAX_TOKENS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── 토스증권 Open API (서버에서만 사용, 브라우저로 전달되지 않음)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 종합매매 계좌가 하나면 비워 두세요.
TOSS_ACCOUNT_SEQ=
# true 일 때만 실계좌 주문 전송이 가능합니다. 모의투자와 조회는 false 로도 동작합니다.
TOSS_ENABLE_LIVE=false

# ── 서버
PORT=8765
